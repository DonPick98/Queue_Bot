# Add these as environment variables in JustRunMy.App.
# Do not upload your local .env with secrets.

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ADMIN_USER_IDS=123456789
TELEGRAM_CHANNEL_ID=-1001234567890

DATABASE_PATH=/app/data/bot.sqlite3

DEFAULT_POST_INTERVAL_MINUTES=60
DEFAULT_BATCH_MODE=auto
DEFAULT_POSTS_PER_RUN=1
DEFAULT_PHOTO_RATIO=1
DEFAULT_VIDEO_RATIO=1
BALANCE_WINDOW=20

# Optional. Set this only if you want an HTTP health endpoint.
# JustRunMy.App can expose this as an HTTPS port.
PORT=8080

# Optional private upload API. Use this for fast uploads outside Telegram chat.
# Generate a long random value and send it as Authorization: Bearer ...
QUEUE_API_TOKEN=<queue-api-token>

# Optional. Defaults to the first ADMIN_USER_IDS value.
# The bot sends media here first only to obtain Telegram file_id/file_unique_id.
QUEUE_API_STAGING_CHAT_ID=123456789

# Optional. If true, deletes the temporary staging message after queueing.
QUEUE_API_DELETE_STAGING=false
QUEUE_API_MAX_MB=50
