# Crea il token parlando con @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# ID numerici degli utenti autorizzati, separati da virgola.
# Consigliato: impostalo prima del primo avvio.
ADMIN_USER_IDS=123456789

# Username pubblico del canale, oppure ID numerico tipo -1001234567890.
# Il bot deve essere amministratore del canale e avere il permesso di pubblicare.
TELEGRAM_CHANNEL_ID=@nome_del_tuo_canale

# Ogni quanti minuti pubblicare un contenuto.
DEFAULT_POST_INTERVAL_MINUTES=60

# Quanti media pubblicare a ogni intervallo, come post singoli separati.
# fixed = usa DEFAULT_POSTS_PER_RUN, auto = 1 fino a 20 in coda, 2 sopra 20, 3 sopra 40.
DEFAULT_BATCH_MODE=fixed
DEFAULT_POSTS_PER_RUN=1

# Bilanciamento desiderato foto:video. 1:1 alterna il piu possibile.
DEFAULT_PHOTO_RATIO=1
DEFAULT_VIDEO_RATIO=1

# Quanti post recenti guardare per decidere il prossimo tipo di media.
BALANCE_WINDOW=20

# Percorso database locale.
DATABASE_PATH=./data/bot.sqlite3
