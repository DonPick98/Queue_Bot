# Crea il token parlando con @BotFather.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# ID numerici degli utenti autorizzati, separati da virgola.
# Consigliato: impostalo prima del primo avvio.
ADMIN_USER_IDS=123456789

# Username pubblico del canale, oppure ID numerico tipo -1001234567890.
# Il bot deve essere amministratore del canale e avere il permesso di pubblicare.
TELEGRAM_CHANNEL_ID=@nome_del_tuo_canale

# Canale pubblico Mouth Preview. Lascialo vuoto finche il bot non e amministratore.
PREVIEW_CHANNEL_ID=

# Mouth Preview V1: solo immagini, 2 al giorno, 48 ore dopo Premium.
PREVIEW_DELAY_HOURS=48
PREVIEW_POSTS_PER_DAY=2
PREVIEW_POSTING_TIMES=10:00,20:00
PREVIEW_MEMBERPASS_URL=https://my.subscriby.net/306354e7c4
PREVIEW_MEMBERPASS_LINK_VERSION=v2
PREVIEW_ATTRIBUTION=@MouthPreview · Full daily feed ↓
# PREVIEW_ATTRIBUTION resta solo per compatibilita: le foto Preview non hanno caption.
PREVIEW_WATERMARK_ENABLED=true
PREVIEW_WATERMARK_TEXT=@MouthPreview
PREVIEW_WATERMARK_OPACITY=64
# Dimensione font come percentuale del lato corto dell'immagine (3-18).
PREVIEW_WATERMARK_SCALE_PERCENT=10


# 0=lunedi ... 6=domenica. Il recap e sempre silenzioso.
PREVIEW_RECAP_WEEKDAY=6
PREVIEW_RECAP_TIME=21:00

# Ogni quanti minuti pubblicare un contenuto. 120 = 12 post/giorno.
DEFAULT_POST_INTERVAL_MINUTES=120

# anchored = slot fissi da mezzanotte locale (00:00, 02:00, 04:00... con intervallo 120).
# interval = prossimo post calcolato dall'ultimo post/riavvio.
DEFAULT_SCHEDULE_MODE=anchored

# Quanti media pubblicare a ogni intervallo, come post singoli separati.
# fixed = usa DEFAULT_POSTS_PER_RUN, auto = 1 fino a 20 in coda, 2 sopra 20, 3 sopra 40.
DEFAULT_BATCH_MODE=fixed
DEFAULT_POSTS_PER_RUN=1
DEFAULT_QUEUE_ORDER=random

# Bilanciamento desiderato foto:video. 1:1 alterna il piu possibile.
DEFAULT_PHOTO_RATIO=1
DEFAULT_VIDEO_RATIO=1

# Quanti post recenti guardare per decidere il prossimo tipo di media.
BALANCE_WINDOW=20

# Orari mostrati e impostati in questo fuso.
DEFAULT_TIMEZONE=Europe/Rome

# Numero massimo di post automatici con notifica udibile per giorno locale (0-3).
DEFAULT_AUDIBLE_POSTS_PER_DAY=3

# all = sempre; oppure finestre come 10:00-23:30 o 09:00-13:00,15:00-23:00.
DEFAULT_POSTING_WINDOWS=all

# Backup automatico dello stato via Telegram agli admin.
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_INTERVAL_MINUTES=1440

# Dopo ogni post pubblicato crea/sovrascrive un backup rolling.
# Se SEND_TELEGRAM=true lo invia anche agli admin, piu sicuro su host senza storage persistente.
BACKUP_AFTER_PUBLISH_ENABLED=true
BACKUP_AFTER_PUBLISH_SEND_TELEGRAM=false
BACKUP_AFTER_PUBLISH_PATH=./state_backups/latest-state.zip
BACKUP_SQLITE_VACUUM_ENABLED=true

# Se DB manca/vuoto/corrotto all'avvio, prova a ripristinare dal backup rolling.
# Prima dello shutdown/redeploy crea comunque un backup rolling.
BACKUP_AUTO_RESTORE_ENABLED=true
BACKUP_AUTO_RESTORE_IF_EMPTY=true
BACKUP_TELEGRAM_AUTO_DOWNLOAD_ENABLED=true
BACKUP_BEFORE_SHUTDOWN_ENABLED=true

# Percorso database locale.
DATABASE_PATH=./data/bot.sqlite3
